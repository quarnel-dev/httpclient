{
  "name": "@quarnel/httpclient",
  "version": "0.0.0",
  "description": "Isomorphic HTTP client built on native fetch, with zero dependencies, for Node.js and the browser",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "author": "Quarnel",
  "license": "MIT",
  "keywords": [
    "http",
    "fetch",
    "http-client",
    "isomorphic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quarnel-dev/httpclient.git"
  },
  "bugs": {
    "url": "https://github.com/quarnel-dev/httpclient/issues"
  },
  "homepage": "https://github.com/quarnel-dev/httpclient#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "prettier": "^3.9.7",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
